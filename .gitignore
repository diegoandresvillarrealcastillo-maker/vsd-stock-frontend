# ============================================================
#  VSD Stock (frontend) - archivos que nunca deben llegar al repositorio
# ============================================================

# ---------- Secretos y entorno ----------
# Regla critica: ningun archivo de entorno real se versiona.
# Solo .env.example, que contiene los nombres de las variables sin valores.
# Ojo: todo lo que lleva el prefijo VITE_ termina en el paquete que se
# descarga el navegador. Un secreto ahi es un secreto publicado.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ---------- Dependencias ----------
node_modules/

# ---------- Artefactos de construccion ----------
# Anclados a la raiz con "/" inicial para no ignorar por accidente una
# carpeta del codigo fuente que se llame igual (fallo que ya nos costo
# tiempo en VSD Health).
/dist/
/build/
/out/
.vite/
*.tsbuildinfo

# ---------- Pruebas y cobertura ----------
coverage/
.nyc_output/
test-results/
# Informes de Lighthouse (npm run lighthouse); el CI los guarda como artefacto.
.lighthouseci/

# ---------- Cache de herramientas ----------
.cache/
.eslintcache

# ---------- Registros ----------
logs/
*.log
npm-debug.log*

# ---------- Editores ----------
.idea/
# Del editor se comparte lo que afecta al proyecto y se ignora lo que es
# personal de cada maquina.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini
